create table
  TJS_INTEGRACAOMOD (
    MOD_ST_TBLMEGA varchar2(100) not null,
    MOD_ST_PKMEGA varchar2(100) not null,
    MOD_DT_DATAMOD date not null,
    MOD_DT_DATAENV date not null
  )
;

alter table TJS_INTEGRACAOMOD
add constraint PK_TJS_INTEGRACAOMOD primary key (MOD_ST_TBLMEGA, MOD_ST_PKMEGA)
;

alter table TJS_INTEGRACAOMOD
add constraint IDX_TJS_INTEGRACAOMOD_MOD_ST_PKMEGA primary key (MOD_ST_PKMEGA)
;

alter table TJS_INTEGRACAOMOD
add constraint IDX_TJS_INTEGRACAOMOD_MOD_ST_TBLMEGA primary key (MOD_ST_TBLMEGA)
;
