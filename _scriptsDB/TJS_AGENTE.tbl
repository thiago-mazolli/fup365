create table
  TJS_AGENTE (
    AGN_TAB_IN_CODIGO number(3) not null,
    AGN_PAD_IN_CODIGO number(3) not null,
    AGN_IN_CODIGO number(7) not null,
    AGN_CH_INTEGRAFUP char(1) not null
  )
;

alter table TJS_AGENTE
add constraint PK_TJS_AGENTE primary key (AGN_TAB_IN_CODIGO, AGN_PAD_IN_CODIGO, AGN_IN_CODIGO)
;

alter table TJS_AGENTE
add constraint FK_TJS_AGN_GLOAGN foreign key (AGN_TAB_IN_CODIGO, AGN_PAD_IN_CODIGO, AGN_IN_CODIGO)
references GLO_AGENTES (AGN_TAB_IN_CODIGO, AGN_PAD_IN_CODIGO, AGN_IN_CODIGO) on delete cascade
;
