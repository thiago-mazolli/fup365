create table
  TJS_INTEGRACAOLOG (
    LOG_DT_DATA date not null,
    MOD_ST_TBLMEGA varchar2(100) not null,
    MOD_ST_PKMEGA varchar2(100) not null,
    LOG_CH_STATUS char(1) not null,
    LOG_ST_MSG varchar2(255),
    LOG_CL_REQUEST clob,
    LOG_CL_RESPONSE clob
  )
;

alter table TJS_INTEGRACAOLOG
add constraint PK_TJS_INTEGRACAOLOG primary key (LOG_DT_DATA, MOD_ST_TBLMEGA, MOD_ST_PKMEGA)
;

alter table TJS_INTEGRACAOLOG
add constraint FK_TJS_INTEGRACAOLOG_TJS_INTEGRACAOMOD foreign key (MOD_ST_TBLMEGA, MOD_ST_PKMEGA)
references TJS_INTEGRACAOMOD (MOD_ST_TBLMEGA, MOD_ST_PKMEGA) on delete cascade
;
