create table
  TJS_INTEGRACAOCFG (
    CFG_ST_METODO varchar2(10) not null,
    CFG_ST_HOST varchar2(255) not null,
    CFG_ST_AUTHKEY varchar2(4000),
    CFG_ST_AUTHMETODO varchar2(10),
    CFG_ST_AUTHHOST varchar2(255),
    CFG_ST_AUTHPATH varchar2(255)
  )
;

alter table TJS_INTEGRACAOCFG
add constraint PK_TJS_INTEGRACAOCFG primary key (CFG_ST_METODO, CFG_ST_HOST)
;

comment on column TJS_INTEGRACAOCFG.CFG_ST_METODO is 'Método - POST; PUT; GET; DELETE'
;

comment on column TJS_INTEGRACAOCFG.CFG_ST_AUTHMETODO is 'Método - POST; PUT; GET; DELETE'
;
