create table
  TJS_NOTIFICLOG (
    LOG_DT_DATA date not null,
    NFD_ST_TBLMEGA varchar2(100) not null,
    NFD_ST_PKMEGA varchar2(100) not null,
    NFD_ST_WEBHOOKHOST varchar2(255),
    LOG_CH_STATUS char(1) not null,
    LOG_ST_MSG varchar2(255),
    LOG_CL_REQUEST clob,
    LOG_CL_RESPONSE clob
  )
