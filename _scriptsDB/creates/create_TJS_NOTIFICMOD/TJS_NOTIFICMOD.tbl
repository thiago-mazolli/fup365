create table
  TJS_NOTIFICMOD (
    NFD_ST_TBLMEGA varchar2(100) not null,
    NFD_ST_PKMEGA varchar2(100) not null,
    NFD_DT_DATAMOD date not null,
    NFD_DT_DATAENV date not null,
    NFD_ST_WEBHOOKMETODO varchar2(10) not null,
    NFD_ST_WEBHOOKHOST varchar2(255) not null,
    NFD_ST_WEBHOOKPATH varchar2(255) not null,
    NFD_ST_AUTHKEY varchar2(4000),
    NFD_ST_AUTHMETODO varchar2(10),
    NFD_ST_AUTHHOST varchar2(255),
    NFD_ST_AUTHPATH varchar2(255),
    NFD_ST_EVENTODESC varchar2(255)
  )
