create table
  TJS_INTEGRACAOMOD (
    MOD_ST_TBLMEGA varchar2(100) not null,
    MOD_ST_PKMEGA varchar2(100) not null,
    MOD_DT_DATAMOD date not null,
    MOD_DT_DATAENV date not null,
    MOD_ST_METODO varchar2(10) not null,
    CFG_ST_HOST varchar2(255) not null,
    MOD_ST_PATH varchar2(255) not null,
    CFG_ST_AUTHKEY varchar2(4000),
    CFG_ST_AUTHMETODO varchar2(10),
    CFG_ST_AUTHHOST varchar2(255),
    CFG_ST_AUTHPATH varchar2(255),
    MOD_ST_IDME varchar2(50)
  )
