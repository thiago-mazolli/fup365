{
  "name": "api-fup365-v1",
  "version": "1.0.0",
  "main": "./src/server.ts",
  "author": "TJSys",
  "license": "MIT",
  "description": "",
  "private": true,
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "set NODE_ENV=development && tsx watch ./src/server.ts",
    "doc": "tsx ./src/swagger/index.ts",
    "clear-dist": "if exist dist\\ rmdir /s /q .\\dist",
    "build-main": "tsup ./src/server.ts",
    "build": "yarn doc && yarn clear-dist && yarn build-main",
    "deploy-start": "pm2 start ecosystem.config.js --env production && pm2 save",
    "deploy-stop": "pm2 delete ecosystem.config.js"
  },
  "devDependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^6.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "6.4.1",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "7.21.5",
    "eslint-plugin-react-hooks": "4 || ^3 || ^2.3.0 || ^1.7.0",
    "oracledb": "^5.1.0",
    "prettier": "^1.19.1",
    "tsup": "^6.7.0",
    "tsx": "^3.14.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.1.4",
    "@types/oracledb": "^5.1.0",
    "axios": "^0.27.2",
    "cors": "^2.8.5",
    "cron-schedule": "^3.0.6",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.0",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^4.1.8"
  }
}
