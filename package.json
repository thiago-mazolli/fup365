{
  "name": "api-fup365",
  "version": "1.0.0",
  "main": "./src/server.ts",
  "author": "TJSys",
  "license": "MIT",
  "description": "",
  "private": true,
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "set NODE_ENV=development && tsx watch ./src/server.ts",
    "clear-dist": "if exist dist\\ rmdir /s /q .\\dist",
    "build-main": "tsup ./src/server.ts",
    "build": "yarn && yarn clear-dist && yarn build-main",
    "build-prod": "yarn clear-dist && yarn build-main && yarn --production",
    "package3": "npx pkg . && yarn",
    "package2": "xcopy \"./node_modules\" \"dist/node_modules\" /E /I /Y",
    "package1": "yarn build-prod",
    "package": "yarn package1 && yarn package2 && yarn package3",
    "deploy-start": "pm2 start ecosystem.config.js --env production",
    "deploy-stop": "pm2 delete ecosystem.config.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.19.9",
    "@types/node-cron": "^3.0.11",
    "@types/oracledb": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "4.0.1",
    "@typescript-eslint/parser": "4.0.1",
    "eslint": "7.32.0",
    "eslint-config-airbnb": "18.2.1",
    "eslint-config-prettier": "6.1.0",
    "eslint-plugin-import": "2.25.2",
    "eslint-plugin-jsx-a11y": "6.4.1",
    "eslint-plugin-prettier": "3.1.0",
    "eslint-plugin-react": "7.21.5",
    "eslint-plugin-react-hooks": "4 || ^3 || ^2.3.0 || ^1.7.0",
    "excel4node": "^1.8.2",
    "nodemailer": "^6.7.7",
    "prettier": "1.18.2",
    "tsup": "^6.7.0",
    "tsx": "^3.12.7",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "cors": "^2.8.5",
    "cron-schedule": "^3.0.6",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.0",
    "oracledb": "^5.1.0",
    "selective-whitespace": "^1.0.4"
  },
  "pkg": {
    "scripts": [
      "dist/**/*",
      "!dist/**/*.md",
      "!dist/**/*.txt",
      "!dist/**/*.yml",
      "!dist/**/*.d.ts",
      "!dist/**/*.editorconfig",
      "!dist/**/*.lock",
      "!dist/**/*.eslintignore",
      "!dist/**/*.eslintrc",
      "!dist/**/*.npmignore",
      "!dist/**/*.yaml",
      "!dist/**/*.markdown",
      "!dist/**/LICENSE"
    ],
    "public": [
      "appConfig.json"
    ],
    "assets": [
      "/**/*.json",
      "images/**/*",
      "dist/public/**/*",
      "public/**/*",
      "dist/_scriptsDB/**/*",
      "_scriptsDB/**/*",
      "/**/*.cjs"
    ],
    "targets": [
      "node18-x64"
    ],
    "outputPath": "build"
  },
  "bin": {
    "start": "./dist/server.js"
  }
}